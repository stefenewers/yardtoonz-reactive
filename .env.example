# Credential-free local defaults
DATABASE_URL=file:./.data/yardtoonz.db
ARTIFACT_ROOT=./.data/artifacts
IMAGE_PROVIDER=MOCK
ANIMATION_PROVIDER=MOCK
MAX_UPLOAD_MB=100
WORKER_POLL_MS=1000

# Optional future live providers. Live adapters are not implemented in E1.1.
# Set IMAGE_PROVIDER=OPENAI to require both OpenAI settings.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
# Set ANIMATION_PROVIDER=RUNWAY to require both Runway settings.
RUNWAY_API_KEY=
RUNWAY_MODEL=
